# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_key_here
EMAIL_TO=office@trainingadvantagegroup.co.uk
NEXT_PUBLIC_SITE_URL=https://www.trainingadvantagegroup.co.uk

# ─── Admin Portal ─────────────────────────────────────────────────────────────
# Password to log in to /admin
ADMIN_PASSWORD=changeme-to-a-strong-password
# Secret used as the session token value — must be a long random string
ADMIN_SECRET=generate-a-random-64-char-string-here

# ─── Vercel KV (optional — for production persistent storage) ─────────────────
# Add the Vercel KV integration in your Vercel dashboard, then copy the values:
# KV_REST_API_URL=https://xxxxx.kv.vercel-storage.com
# KV_REST_API_TOKEN=your_token_here
