# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_key_here
EMAIL_TO=office@trainingadvantagegroup.co.uk
NEXT_PUBLIC_SITE_URL=https://www.trainingadvantagegroup.co.uk

# ─── Google Analytics (GA4) ───────────────────────────────────────────────────
# Create a GA4 property at analytics.google.com → Admin → Data Streams → Web
# Only loads client-side after a visitor accepts the cookie consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Admin Portal ─────────────────────────────────────────────────────────────
# Password to log in to /admin
ADMIN_PASSWORD=changeme-to-a-strong-password
# Secret used as the session cookie value — must be a long random string (32+ chars)
ADMIN_SECRET=generate-a-random-64-char-string-here

# ─── Secure Portal (instructors/suppliers/staff/candidates) ───────────────────
# Signs portal session cookies (lib/portal-auth.ts) — must be a different random
# string from ADMIN_SECRET (32+ chars).
PORTAL_SESSION_SECRET=generate-a-different-random-64-char-string-here

# ─── Neon PostgreSQL (production persistent storage) ──────────────────────────
# 1. Sign up free at https://neon.tech
# 2. Create a project → copy the connection string from the dashboard
# 3. Paste it here AND add it to your Vercel environment variables
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# Tables are created automatically on first write — no manual migration needed.

# ─── Google Reviews ───────────────────────────────────────────────────────────
# 1. console.cloud.google.com → Enable "Places API (New)"
# 2. Create an API key (restrict it to Places API + your domain)
# 3. Find your Place ID: search your business on Google Maps → copy the ChIJ... from the URL
#    or use: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_PLACE_ID=ChIJ_your_place_id_here
# Reviews are cached for 24 hours — you're billed ~$0.017 per API call (free $200/mo credit)

# ─── Square Payments ──────────────────────────────────────────────────────────
# Production credentials from https://developer.squareup.com
SQUARE_ACCESS_TOKEN=your_production_access_token
SQUARE_LOCATION_ID=your_location_id
# Signature key from Square Dashboard → Webhooks → your endpoint
SQUARE_WEBHOOK_SIGNATURE_KEY=your_webhook_signature_key
# Your live domain (no trailing slash)
NEXT_PUBLIC_URL=https://trainingadvantagegroup.co.uk

# ─── Vercel Blob (image uploads from admin) ───────────────────────────────────
# 1. Go to your Vercel project → Storage tab → Create Blob Store
# 2. It auto-adds BLOB_READ_WRITE_TOKEN to your Vercel env vars
# 3. For local dev, copy the token value here
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# ─── TAG-WEB-REQ-001 / TAG-SEC-PROC-001 integration points ────────────────────
# These routes are referenced throughout the controlled requirements documents
# but no real addresses/URLs were supplied. PLACEHOLDER values below must be
# replaced with the real TAG-issued values before go-live.
ORDER_HANDOFF_MAILBOX=office@trainingadvantagegroup.co.uk
JOTFORM_REGISTRATION_URL=https://form.jotform.com/262148439891064
JOTFORM_UPDATE_URL=https://form.jotform.com/262153310272041
JOTFORM_COURSE_BOOKING_URL=https://form.jotform.com/PLACEHOLDER-course-booking
# INSTRUCTOR_PORTAL_URL / SUPPLIER_PORTAL_URL are deprecated — the Instructor and
# Supplier secure areas are now the in-house /portal/login system (see
# lib/portal-auth.ts, /admin/portal-users, /admin/portal-resources) instead of an
# external SharePoint link.
# Document/version control shown on checkout & the order handoff email.
TERMS_VERSION=TAG-TERMS-v1.0
PRIVACY_NOTICE_VERSION=TAG-PRIV-v1.0
