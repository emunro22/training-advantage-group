# Email Configuration (Nodemailer)
# Copy this file to .env.local and fill in your SMTP credentials

# SMTP Settings (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Recipients
EMAIL_FROM=office@trainingadvantagegroup.co.uk
EMAIL_TO=office@trainingadvantagegroup.co.uk

# Site URL (for email links)
NEXT_PUBLIC_SITE_URL=https://www.trainingadvantagegroup.co.uk
